<?xml version="1.0" encoding="utf-8"?>
<!--com.google.android.material.card.MaterialCardView-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardPost"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="4dp"
    android:focusable="true"
    android:padding="8dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="vertical">

        <!-- Nome do utilizador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ICB_tvUsername"
                style="@style/AppText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/ICB_tvDate"
                style="@style/AppText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="8dp"
                android:text=""
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ICB_tvContent"
            style="@style/AppText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text=""
            android:textSize="14sp" />

        <!-- Campos adicionais -->

        <!--
        <TextView
            android:id="@+id/tvTripLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver viagem associada"
            android:textColor="@android:color/holo_blue_dark"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMapLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver no mapa"
            android:textColor="@android:color/holo_blue_dark"
            android:visibility="gone" />
        -->
        <!--?xml version="1.0" encoding="utf-8"?>
        <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        </androidx.constraintlayout.widget.ConstraintLayout-->


    </LinearLayout>

</androidx.cardview.widget.CardView>